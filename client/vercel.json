{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://zelda-api-kbtl.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://zelda-api-kbtl.onrender.com/uploads/:path*" },
    { "source": "/((?!api|uploads/).*)", "destination": "/index.html" }
  ]
}
