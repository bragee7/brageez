# Copy to .env.production / .env.local as needed and adjust values.
# The app currently reads /api via Vite's dev proxy (vite.config.js) and
# rewrites in vercel.json, so these are optional for production builds.
VITE_API_URL=/api
VITE_MEDIA_URL=

# Idle auto-logout timeout in minutes (default: 30).
VITE_IDLE_TIMEOUT=30
