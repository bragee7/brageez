DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zelda_new
DB_USER=root
DB_PASSWORD=

# ─────────────────────────────────────────────────────────────
# AUTHENTICATION - JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=women-safety-guardian-secret-key-2024

# ─────────────────────────────────────────────────────────────
# EMAIL - Nodemailer (Gmail SMTP)
#
# IMPORTANT: Gmail requires an App Password, not your regular
# account password. To generate one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Factor Authentication
#   3. Go to "App passwords" (search for it)
#   4. Generate a new app password for "Mail"
#   5. Use that 16-character app password as EMAIL_PASS
# ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Women Safety Guardian <guardianportal123@gmail.com>
POLICE_EMAIL=police@guardian.com

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────────────────────
# CLIENT/API
# ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000